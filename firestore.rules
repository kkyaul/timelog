rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // timelog 컬렉션 — 본인(Firebase Auth 로그인) 만 접근 가능
    match /timelog/{dateId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "bK2FZTQ1mzPjrQFMAwrjM2o4Jbz1";
      // YOUR_FIREBASE_UID: Firebase Console > Authentication > Users 에서 확인
    }
  }
}
